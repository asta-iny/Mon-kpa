// LibFind Phase 0 — Prisma / MySQL foundation
// Product domain models (listings, messaging, payments, etc.) remain Phase 1+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Foundation marker table proving migrations + InnoDB baseline.
model SchemaBootstrap {
  id        String   @id @db.Char(36)
  label     String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("schema_bootstrap")
}

// --- Identity / RBAC / OTP / Session (M0-013) ---

model User {
  id           String    @id @db.Char(36)
  phoneE164    String    @unique @map("phone_e164") @db.VarChar(20)
  displayName  String?   @map("display_name") @db.VarChar(120)
  status       String    @default("active") @db.VarChar(32)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(3)

  roles              UserRole[]
  sessions           Session[]
  otpChallenges      OtpChallenge[]
  mediaAssets        MediaAsset[]
  auditEvents        AuditEvent[] @relation("AuditActor")
  listings           Listing[]
  verifications      Verification[] @relation("VerificationReviewer")
  reports            Report[]       @relation("ReportReporter")
  moderatedReports   Report[]       @relation("ReportModerator")
  moderationActions  ModerationAction[]

  messagesSent       Message[]      @relation("MessageSender")
  messagesReceived   Message[]      @relation("MessageRecipient")
  transactionsSent   Transaction[]  @relation("TransactionSeller")
  transactionsReceived Transaction[] @relation("TransactionBuyer")

  @@map("users")
}

model Role {
  id          String   @id @db.Char(36)
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @db.Char(36)
  code        String   @unique @db.VarChar(96)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Char(36)
  roleId     String   @map("role_id") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// OTP challenges store only a secure hash of the code (never plaintext).
model OtpChallenge {
  id              String    @id @db.Char(36)
  userId          String?   @map("user_id") @db.Char(36)
  phoneE164       String    @map("phone_e164") @db.VarChar(20)
  codeHash        String    @map("code_hash") @db.VarChar(255)
  expiresAt       DateTime  @map("expires_at") @db.DateTime(3)
  consumedAt      DateTime? @map("consumed_at") @db.DateTime(3)
  attemptCount    Int       @default(0) @map("attempt_count")
  maxAttempts     Int       @default(5) @map("max_attempts")
  requestIpHash   String?   @map("request_ip_hash") @db.VarChar(128)
  requestDeviceId String?   @map("request_device_id") @db.VarChar(128)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneE164, createdAt])
  @@map("otp_challenges")
}

/// Refresh-token sessions: reuse of a rotated token revokes the session family.
model Session {
  id               String    @id @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  familyId         String    @map("family_id") @db.Char(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById     String?   @map("replaced_by_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

// --- Locations (M0-014) — county → district → community hierarchy ---

model County {
  id        String   @id @db.Char(36)
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  districts District[]
  listings  Listing[]

  @@map("counties")
}

model District {
  id        String   @id @db.Char(36)
  countyId  String   @map("county_id") @db.Char(36)
  code      String   @db.VarChar(64)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  county      County      @relation(fields: [countyId], references: [id], onDelete: Restrict)
  communities Community[]
  listings    Listing[]

  @@unique([countyId, code])
  @@map("districts")
}

model Community {
  id         String   @id @db.Char(36)
  districtId String   @map("district_id") @db.Char(36)
  code       String   @db.VarChar(64)
  name       String   @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  listings Listing[]

  @@unique([districtId, code])
  @@map("communities")
}

// --- Categories (M0-024) ---

model Category {
  id          String   @id @db.Char(36)
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  parentId    String?  @map("parent_id") @db.Char(36)
  sortOrder   Int      @default(0) @map("sort_order")
  isSynthetic Boolean  @default(false) @map("is_synthetic")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  listings Listing[]

  @@map("categories")
}

// --- Listings (Phase 1: EPIC-05) ---
// Lifecycle: draft → active → paused/sold/archived/expired

model Listing {
  id            String    @id @db.Char(36)
  ownerId       String    @map("owner_id") @db.Char(36)
  categoryId    String    @map("category_id") @db.Char(36)
  countyId      String    @map("county_id") @db.Char(36)
  districtId    String?   @map("district_id") @db.Char(36)
  communityId   String?   @map("community_id") @db.Char(36)
  title         String    @db.VarChar(200)
  description   String    @db.Text
  priceAmount   String    @map("price_amount") @db.VarChar(32)
  priceCurrency String    @map("price_currency") @db.VarChar(3)
  status        String    @default("draft") @db.VarChar(32)
  availableFrom DateTime? @map("available_from") @db.DateTime(3)
  availableUntil DateTime? @map("available_until") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt     DateTime? @map("deleted_at") @db.DateTime(3)

  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  county    County   @relation(fields: [countyId], references: [id], onDelete: Restrict)
  district  District? @relation(fields: [districtId], references: [id], onDelete: Restrict)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Restrict)
  media     MediaAsset[]
  transactions Transaction[] @relation("TransactionListing")

  @@index([ownerId])
  @@index([categoryId])
  @@index([countyId, districtId, communityId])
  @@index([status, createdAt])
  @@index([availableFrom, availableUntil])
  @@map("listings")
}

// --- Transactions (Phase 3: EPIC-12) ---
// Lifecycle: pending → confirmed → completed → cancelled/refunded

model Transaction {
  id                String    @id @db.Char(36)
  buyerId           String    @map("buyer_id") @db.Char(36)
  sellerId          String    @map("seller_id") @db.Char(36)
  listingId         String    @map("listing_id") @db.Char(36)
  amount              String    @map("amount") @db.VarChar(32)
  currency          String    @map("currency") @db.VarChar(3)
  status            String    @default("pending") @db.VarChar(32)
  paymentMethod     String?   @map("payment_method") @db.VarChar(64)
  transactionDate   DateTime  @map("transaction_date") @db.DateTime(3)
  completedAt       DateTime? @map("completed_at") @db.DateTime(3)
  cancelledAt       DateTime? @map("cancelled_at") @db.DateTime(3)
  refundedAt        DateTime? @map("refunded_at") @db.DateTime(3)
  metadataJson      Json?     @map("metadata_json")

  buyer User @relation("TransactionBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller User @relation("TransactionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  listing Listing @relation("TransactionListing", fields: [listingId], references: [id], onDelete: Restrict)

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([listingId, status])
  @@map("transactions")
}

// --- Verification (Phase 1: EPIC-07) ---

model Verification {
  id           String    @id @db.Char(36)
  subjectType  String    @map("subject_type") @db.VarChar(32)
  subjectId    String    @map("subject_id") @db.Char(36)
  type         String    @db.VarChar(32)
  status       String    @default("pending") @db.VarChar(32)
  evidenceJson Json?     @map("evidence_json")
  reviewerId   String?   @map("reviewer_id") @db.Char(36)
  reviewerNotes String?  @map("reviewer_notes") @db.VarChar(1000)
  expiresAt    DateTime? @map("expires_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  reviewer User? @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId])
  @@index([type, status])
  @@index([status, createdAt])
  @@map("verifications")
}

// --- Reports (Phase 1: EPIC-07) ---

model Report {
  id           String    @id @db.Char(36)
  reporterId   String    @map("reporter_id") @db.Char(36)
  subjectType  String    @map("subject_type") @db.VarChar(32)
  subjectId    String    @map("subject_id") @db.Char(36)
  reason       String    @db.VarChar(96)
  detail       String?   @db.Text
  status       String    @default("open") @db.VarChar(32)
  moderatorId  String?   @map("moderator_id") @db.Char(36)
  moderatorNotes String? @map("moderator_notes") @db.VarChar(1000)
  resolvedAt   DateTime? @map("resolved_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  reporter   User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator  User? @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  moderationActions ModerationAction[] @relation("ModerationActionReport")

  @@index([subjectType, subjectId])
  @@index([status, createdAt])
  @@map("reports")
}

// --- Moderation Actions (Phase 1: EPIC-07) ---

model ModerationAction {
  id           String    @id @db.Char(36)
  reportId     String?   @map("report_id") @db.Char(36)
  moderatorId  String    @map("moderator_id") @db.Char(36)
  action       String    @db.VarChar(96)
  targetType   String    @map("target_type") @db.VarChar(32)
  targetId     String    @map("target_id") @db.Char(36)
  reason       String    @db.VarChar(255)
  metadataJson Json?     @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  report     Report? @relation("ModerationActionReport", fields: [reportId], references: [id], onDelete: SetNull)
  moderator  User    @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([targetType, targetId])
  @@index([moderatorId, createdAt])
  @@map("moderation_actions")
}

// --- Messaging (Phase 2: EPIC-11) ---

model Message {
  id               String    @id @db.Char(36)
  senderId         String    @map("sender_id") @db.Char(36)
  recipientId      String    @map("recipient_id") @db.Char(36)
  content          String    @db.Text
  type             String    @default("text") @db.VarChar(32)
  status           String    @default("sent") @db.VarChar(32)
  metadataJson     Json?     @map("metadata_json")
  read             Boolean   @default(false) @map("read")
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

// --- Audit (M0-015, ADR-012) — append-only hash-chained ---

model AuditEvent {
  id           String   @id @db.Char(36)
  seq          BigInt   @default(autoincrement())
  actorId      String?  @map("actor_id") @db.Char(36)
  action       String   @db.VarChar(96)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.Char(36)
  payloadJson  Json?    @map("payload_json")
  prevHash     String   @map("prev_hash") @db.Char(64)
  hash         String   @db.Char(64)
  requestId    String?  @map("request_id") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([seq])
  @@index([createdAt])
  @@map("audit_events")
}

// --- Media metadata (M0-025+) — binaries live in Cloudinary ---

model MediaAsset {
  id               String    @id @db.Char(36)
  ownerId          String    @map("owner_id") @db.Char(36)
  listingId        String?   @map("listing_id") @db.Char(36)
  cloudinaryPublicId String  @map("cloudinary_public_id") @db.VarChar(255)
  resourceType     String    @default("image") @map("resource_type") @db.VarChar(32)
  format           String?   @db.VarChar(32)
  bytes            Int?
  width            Int?
  height           Int?
  secureUrl        String?   @map("secure_url") @db.VarChar(512)
  status           String    @default("active") @db.VarChar(32)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([listingId])
  @@unique([cloudinaryPublicId])
  @@map("media_assets")
}

// --- M0 search spike only (not product listings) ---

model SearchSpikeDocument {
  id        String   @id @db.Char(36)
  title     String   @db.VarChar(200)
  body      String   @db.Text
  countyCode String? @map("county_code") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([countyCode])
  @@map("search_spike_documents")
}

// --- Reputation & Reviews (Phase 2: EPIC-13) ---

model Review {
  id              String    @id @db.Char(36)
  reviewerId      String    @map("reviewer_id") @db.Char(36)
  subjectId       String    @map("subject_id") @db.Char(36)
  subjectType     String    @map("subject_type") @db.VarChar(32) // 'user' | 'listing' | 'transaction'
  rating          Int       @default(5) @db.Int(1)
  title           String    @db.VarChar(200)
  body            String    @db.Text
  status          String    @default("pending") @db.VarChar(32) // 'pending' | 'approved' | 'rejected'
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  parentId        String?   @map("parent_id") @db.Char(36)
  helpfulCount    Int       @default(0) @db.Int(3)
  unhelpfulCount  Int       @default(0) @db.Int(3)

  reviewer User @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  subject   Subject @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId])
  @@index([status, createdAt])
  @@map("reviews")
}

model Subject {
  id        String   @id @db.Char(36)
  userId    String?  @map("user_id") @db.Char(36)
  listingId String?   @map("listing_id") @db.Char(36)
  transactionId String? @map("transaction_id") @db.Char(36)

  user   User? @relation("UserSubject", fields: [userId], references: [id], onDelete: SetNull)
  listing Listing? @relation("ListingSubject", fields: [listingId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation("TransactionSubject", fields: [transactionId], references: [id], onDelete: SetNull)

  @@map("subjects")
}

// Extend User with trust score
model User {
  id           String   @id @db.Char(36)
  phoneE164    String   @unique @map("phone_e164") @db.VarChar(20)
  displayName  String?  @map("display_name") @db.VarChar(120)
  status       String   @default("active") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(3)

  roles              UserRole[]
  sessions           Session[]
  otpChallenges      OtpChallenge[]
  mediaAssets        MediaAsset[]
  auditEvents        AuditEvent[] @relation("AuditActor")
  listings           Listing[]
  verifications      Verification[] @relation("VerificationReviewer")
  reports            Report[]       @relation("ReportReporter")
  moderatedReports   Report[]       @relation("ReportModerator")
  moderationActions  ModerationAction[]

  // Reputation fields (Phase 2)
  trustScore       Int      @default(0) @db.Int(3)
  totalReviews     Int      @default(0) @db.Int(3)
  positiveReviews  Int      @default(0) @db.Int(3)
  averageRating    Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount      Int      @default(0) @db.Int(3)

  messagesSent       Message[]      @relation("MessageSender")
  messagesReceived   Message[]      @relation("MessageRecipient")
  transactionsSent   Transaction[]  @relation("TransactionSeller")
  transactionsReceived Transaction[] @relation("TransactionBuyer")
  reviews            Review[]       @relation("ReviewReviewer")

  @@map("users")
}
