# LibFind environment contract — names and local placeholders only.
# Copy to `.env` for local development. Never commit real secrets.

# --- App ---
NODE_ENV=local
APP_ENV=local
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# --- MySQL 8 (Prisma) ---
# Local docker-compose defaults (synthetic credentials only).
DATABASE_URL=mysql://libfind:libfind@127.0.0.1:3306/libfind

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Cloudinary (server only; never expose API secret to the browser) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Auth secrets (required when auth module is activated; local placeholders only) ---
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# --- Seed safety ---
# Staging seeds require explicit approval:
# ALLOW_STAGING_SEED=true

# --- Frontend (Vite) — public, non-secret values only ---
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_APP_ENV=local
